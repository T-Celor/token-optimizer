# Copy to .env or export in your shell before launching agents.

# Headroom proxy (default port)
HEADROOM_PORT=8787

# Point Anthropic-compatible clients at the local proxy
# ANTHROPIC_BASE_URL=http://127.0.0.1:8787

# Point OpenAI-compatible clients (Copilot, Cursor, custom apps) at the proxy
# OPENAI_BASE_URL=http://127.0.0.1:8787/v1

# Optional: API keys if you are not using subscription / OAuth
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
